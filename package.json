{
  "name": "opencode-command-reviewer",
  "version": "0.0.4",
  "description": "Advisory command explanations and safety ratings for pending OpenCode shell approvals",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mightykatun/opencode-command-reviewer.git"
  },
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist/tui.js",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22",
    "opencode": "1.18.34"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:runtime": "node scripts/smoke.mjs correction && node scripts/smoke.mjs cancel && node scripts/smoke.mjs error && node scripts/smoke.mjs external",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.28.5",
    "@opencode-ai/plugin": "1.18.34",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "24.12.2",
    "babel-preset-solid": "1.9.10",
    "esbuild": "0.28.2",
    "shell-quote": "1.12.0",
    "solid-js": "1.9.12",
    "tsx": "4.23.15",
    "typescript": "5.8.2"
  },
  "overrides": {
    "@babel/core": "$@babel/core"
  }
}
